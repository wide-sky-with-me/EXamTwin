# Never commit real credentials. Copy this file to .env and run
# `uv run examtwin config-check` after changes.

# Application identity. SUBJECT_PACK is only the CLI/worker bootstrap context;
# web requests select a subject explicitly and do not inherit it as a UI default.
APP_NAME=ExamTwin
APP_ENV=development
LOCAL_ACCESS_ONLY=true
API_PREFIX=/api/v1
SUBJECT_PACK=oxfordaqa-mathematics-9660
# Trusted versioned manifests and SKILL.md files loaded at service startup.
SUBJECT_PACKAGES_ROOT=subject-packs

# MinerU document conversion.
MINERU_TOKEN=
MINERU_MODE=precision
MINERU_LANGUAGE=en

# OpenAI-compatible text provider and per-role models.
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_API_KEY=
LLM_MODEL=gpt-5.6-sol
LLM_REASONING_EFFORT=medium
KNOWLEDGE_DIFFICULTY_MODEL=gpt-5.6-luna
KNOWLEDGE_DIFFICULTY_REASONING_EFFORT=low
KNOWLEDGE_DIFFICULTY_TIMEOUT=120
KNOWLEDGE_DIFFICULTY_BATCH_SIZE=20
KNOWLEDGE_GRAPH_MODEL=gpt-5.6-luna
KNOWLEDGE_GRAPH_REASONING_EFFORT=low
KNOWLEDGE_GRAPH_TIMEOUT=120
KNOWLEDGE_GRAPH_BATCH_CHARS=24000
KNOWLEDGE_GRAPH_MAX_BLOCKS=400
GRADING_MODEL=gpt-5.6-sol
GRADING_REASONING_EFFORT=medium
GRADING_TIMEOUT=120
PAPER_SPLIT_MODEL=gpt-5.6-luna
PAPER_SPLIT_REASONING_EFFORT=none
PAPER_SPLIT_TIMEOUT=90
PAPER_SPLIT_MAX_ATTEMPTS=2
PAPER_SPLIT_MAX_CHARS=4000
PAPER_SPLIT_CONCURRENCY=2
PAPER_VISION_ENABLED=true
PAPER_VISION_MODEL=gpt-5.6-terra
PAPER_VISION_REASONING_EFFORT=low
PAPER_VISION_TIMEOUT=120
PAPER_VISION_MAX_ATTEMPTS=3
PAPER_VISION_RETRY_DELAY_SECONDS=2
PAPER_VISION_MIN_CONFIDENCE=0.7
PAPER_VISION_CONCURRENCY=2

# Opt in only when the configured provider exposes an OpenAI-compatible Image API.
IMAGE_GENERATION_ENABLED=false
# Leave these empty to reuse the compatible LLM endpoint and key.
IMAGE_GENERATION_BASE_URL=
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_MODEL=gpt-image-2
IMAGE_GENERATION_TIMEOUT=120
IMAGE_GENERATION_MAX_ATTEMPTS=2
IMAGE_GENERATION_MAX_OUTPUT_BYTES=8388608

# Embedding and reranking provider.
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
RERANK_MODEL=Qwen/Qwen3-Reranker-8B
# Full-corpus batches can exceed interactive latency; keep provider calls bounded at 120s.
EMBEDDING_TIMEOUT=120
RERANK_TIMEOUT=30
RETRIEVAL_PROVIDER_TIMEOUT=15
SIMILARITY_TOP_K=18
RERANK_TOP_N=7
# Dense/sparse fusion, evidence-card recall fallback and local retrieval audit traces.
RETRIEVAL_HYBRID_ALPHA=0.55
RETRIEVAL_RAW_FALLBACK_COUNT=2
RETRIEVAL_TRACE_ENABLED=true
# Keep recent diagnostics per subject; older traces are pruned on write.
RETRIEVAL_TRACE_MAX_ROWS_PER_SUBJECT=2000

# PostgreSQL is the durable schema, paper-job queue, leases, checkpoints and
# task-event source. POSTGRES_* configures Compose; DATABASE_URL configures the app.
POSTGRES_DB=examtwin
POSTGRES_USER=examtwin
POSTGRES_PASSWORD=examtwin_dev
DATABASE_URL=postgresql://examtwin:examtwin_dev@localhost:55432/examtwin
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=examtwin_9660
QDRANT_COLLECTION_ALIAS=examtwin_9660_live

# Persistent source and artifact storage. Compose mounts EXAMTWIN_STORAGE_ROOT
# once at /app/var; application paths below are relative to the project/container.
EXAMTWIN_STORAGE_ROOT=./var
CORPUS_ROOT=data/牛津AQA/数学

# Canonical object storage. Compose runs a loopback-only SeaweedFS S3 endpoint;
# local mode remains available for tests and non-Docker development.
OBJECT_STORE_BACKEND=local
OBJECT_STORE_LOCAL_ROOT=var
OBJECT_STORE_CACHE_DIR=var/object-cache
OBJECT_STORE_ENDPOINT_URL=http://127.0.0.1:8333
OBJECT_STORE_BUCKET=examtwin
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY=examtwin
OBJECT_STORE_SECRET_KEY=examtwin_dev_secret
PAPER_OBJECT_RETENTION_DAYS=30
ANSWER_ARTIFACT_RETENTION_DAYS=30
STORAGE_GC_BATCH_SIZE=200
STORAGE_GC_INTERVAL_SECONDS=3600
KNOWLEDGE_UPLOAD_MAX_BYTES=268435456

# Durable paper worker leases, retry policy and bounded parallelism.
PAPER_CHUNK_PAGES=5
PAPER_LEASE_SECONDS=60
PAPER_WORKER_POLL_SECONDS=2
PAPER_MINERU_TIMEOUT=600
PAPER_MINERU_MAX_ATTEMPTS=3
PAPER_MINERU_RETRY_DELAY_SECONDS=2
PAPER_QUESTION_MAX_ATTEMPTS=3
PAPER_QUESTION_RETRY_DELAY_SECONDS=2
PAPER_QUESTION_CONCURRENCY=4
PAPER_QUESTION_IMAGE_MAX_PAGES=4
PAPER_QUESTION_IMAGE_MAX_TOTAL_BYTES=12582912
PAPER_WORKER_REPLICAS=2
LOCAL_UID=1000
LOCAL_GID=1000

# Answering harness budgets and explicitly allowed remote tool servers.
ANSWER_AGENT_TIMEOUT=300
ANSWER_AGENT_MAX_ITERATIONS=16
ANSWER_AGENT_MAX_TOOL_CALLS=12
# JSON array; every remote tool must also be allowed by its subject skill.
ANSWER_AGENT_MCP_SERVERS_JSON=[]
CORS_ORIGINS=http://localhost:5173
